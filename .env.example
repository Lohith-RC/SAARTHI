[TEMPLATE]
# ===================================================================
# PROJECT SAARTHI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real credentials.
# WARNING: This file documents shape only. Never commit real secrets.
# ===================================================================

# ---------- CLOUD API KEYS (rotate & fill in) ----------
# Groq Cloud API Key (Get free from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Voice Synthesis API Key (Get from https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Customer-supplied AI API keys must stay disabled (server-side keys only)
SAARTHI_CUSTOMER_AI_KEYS=false

# ---------- DATABASE OPTIONS: LOCAL POSTGRESQL OR SUPABASE ----------
# Option A: Local PostgreSQL (default / Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/saarthi
SPRING_DATASOURCE_USERNAME=saarthi
SPRING_DATASOURCE_PASSWORD=your_strong_db_password
SAARTHI_DB_PASSWORD=your_strong_db_password

# Option B: Supabase Managed Cloud PostgreSQL (Zero-Setup Cloud DB)
# 1. Sign up / log in to https://supabase.com and create a project (e.g. "saarthi-db")
# 2. In Supabase Dashboard: Project Settings -> Database -> Connection String (URI)
# 3. Paste the values below (uncomment and replace YOUR_PROJECT_REF and PASSWORD):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY

# ---------- APPLICATION SECURITY (MUST be unique per deployment) ----------
# There is NO default. The application will refuse to boot if these are
# missing or equal to the deprecated public token.
SAARTHI_DEVICE_TOKEN=generate_a_long_random_device_token
SAARTHI_OPERATOR_TOKEN=generate_a_long_random_operator_token
SAARTHI_ENFORCE_TOKEN=true

# Dead-Man's Watchdog: seconds without a heartbeat before a chamber is flagged offline
# SAARTHI_WATCHDOG_TIMEOUT=180

# AI model fallback chains (comma-separated; tried in order when a model fails)
# SAARTHI_GEMINI_CANDIDATE_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
# SAARTHI_GROQ_CANDIDATE_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

SERVER_PORT=8080