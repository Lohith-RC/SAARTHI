# ElevenLabs Voice Synthesis API Key (Get from https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Application Security
SAARTHI_DEVICE_TOKEN=SAARTHI_UUID4_MASTER_SECRET
SERVER_PORT=8080
